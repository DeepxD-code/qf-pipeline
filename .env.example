# v0 needs nothing to boot. Optional upgrades:
STORAGE_DIR=storage
API_HOST=0.0.0.0
API_PORT=8000
# Optional LLM upgrades (leave empty = template engine, still ships valid MP4)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Seconds per scene card in output MP4
SECS_PER_IMAGE=2.5
# Visual backend: cards (offline Pillow, default) | hyperframes (motion HTML render, falls back to cards)
QF_VISUALS=cards
# Composer: python (default) | java (workers/java-renderer, bounded CPU via Semaphore(2))
QF_COMPOSER=python
# Max concurrent renders (bounds ffmpeg processes under burst load)
MAX_CONCURRENT_RENDERS=2
